BUILDSHIELD_HOST=0.0.0.0
BUILDSHIELD_PORT=8080
BUILDSHIELD_ENV=production
BUILDSHIELD_WORKSPACE_ROOT=.

# H2 authentication foundation.
# Generate a password hash before deployment; never commit a real password.
BUILDSHIELD_ADMIN_USERNAME=admin
BUILDSHIELD_ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_PBKDF2_HASH
BUILDSHIELD_SESSION_TTL_SECONDS=3600
BUILDSHIELD_COOKIE_SECURE=false
BUILDSHIELD_LOGIN_MAX_FAILURES=5
BUILDSHIELD_LOGIN_LOCKOUT_SECONDS=60

# H4 request/resource controls for controlled single-instance deployment.
BUILDSHIELD_MAX_REQUEST_BODY_BYTES=65536
BUILDSHIELD_API_RATE_LIMIT_REQUESTS=30
BUILDSHIELD_API_RATE_LIMIT_WINDOW_SECONDS=60
BUILDSHIELD_MAX_CONCURRENT_OPERATIONS=2

# H4C bounded repository scanner budgets.
BUILDSHIELD_SCAN_MAX_ENTRIES=20000
BUILDSHIELD_SCAN_MAX_FILES=500
BUILDSHIELD_SCAN_MAX_FILE_BYTES=2097152
BUILDSHIELD_SCAN_MAX_TOTAL_BYTES=10485760
